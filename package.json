        "build": "npm run generate-routes && now-sdk build",
        "deploy": "now-sdk install",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies"
    },
    "dependencies": {
        "@servicenow/react-components": "^0.1.0",
