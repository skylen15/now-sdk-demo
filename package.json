        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@servicenow/glide": "27.0.5",
        "@servicenow/sdk": "4.7.0",
        "@tanstack/router-cli": "^1.167.13",
        "@types/react": "18.3.12",
        "@types/react-dom": "18.3.1"
    }
